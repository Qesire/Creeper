[Unit]
StartLimitIntervalSec=600
StartLimitBurst=10
Description=Creeper deterministic production supervisor
After=network-online.target creeper-fabric-authority.service
Wants=network-online.target
Requires=creeper-fabric-authority.service
OnFailure=creeper-email-alert@%n.service

[Service]
Type=simple
User=creeper
Group=creeper
WorkingDirectory=/opt/creeper
EnvironmentFile=-/etc/creeper/agent.env
ExecStart=/opt/creeper/.venv/bin/creeper-autopilot /etc/creeper/autopilot.toml
Restart=on-failure
RestartSec=10
MemoryHigh=5G
MemoryMax=7G
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/creeper /var/lib/creeper

[Install]
WantedBy=multi-user.target
