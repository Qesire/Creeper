[Unit]
Description=Creeper daily email production report
After=postgresql.service

[Service]
Type=oneshot
User=creeper
Group=creeper
WorkingDirectory=/opt/creeper
EnvironmentFile=/etc/creeper/report.env
ExecStart=/opt/creeper/.venv/bin/creeper-fabric-email-report --config /etc/creeper/fabric.toml
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/creeper /var/lib/creeper
